# Application process
NODE_ENV=production
# Docker and container platforms must bind 0.0.0.0 so the published port is
# reachable. On a VM behind Caddy/Nginx, bind 127.0.0.1 and expose only the
# reverse proxy, so port 3000 is never publicly reachable.
HOST=0.0.0.0
PORT=3000
# One trusted local reverse proxy (Caddy/Nginx) in the recommended VM setup.
TRUST_PROXY=1

# Final public origin used for canonical URLs, sharing, sitemap and email links.
SITE_URL=https://www.example.com

# Security: generate a long random value (for example: openssl rand -hex 32).
CMS_ADMIN_TOKEN=

# Mount both paths on durable storage in production. Local development can use
# ./cms/data/cms.sqlite and ./uploads instead.
CMS_DB_FILE=/data/cms.sqlite
CMS_UPLOAD_DIR=/data/uploads

# Optional editorial email notifications
SHOLYNK_EDITOR_EMAIL=sholynktech@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
